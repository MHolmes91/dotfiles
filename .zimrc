# Core behavior
zmodule environment
zmodule input
zmodule utility
zmodule termtitle
zmodule run-help

# Productivity
zmodule git
zmodule ssh
zmodule fzf
zmodule zsh-users/zsh-completions --fpath src
zmodule completion
zmodule zsh-users/zsh-autosuggestions
zmodule zsh-users/zsh-history-substring-search

# Platform-specific
if [[ "$OSTYPE" == darwin* ]]; then
  zmodule homebrew
fi
if (( $+commands[pacman] )); then
  zmodule pacman
fi

# Prompt handled via zsh/themes/prompt_holmes.zsh
